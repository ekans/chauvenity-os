# Tailscale's tray icon. tailscale itself comes from bluefin-dx; GNOME shows
# the icon through bluefin's AppIndicator extension.
#
# Upstream's unit (`tailscale configure systray --enable-startup=systemd`) is
# WantedBy=default.target, so it also runs with no graphical session at all.
# graphical-session.target is reached by every graphical login, GNOME and niri
# alike, and stopped at logout.
#
# Named like upstream's on purpose: a copy made with `tailscale configure
# systray` in ~/.config/systemd/user shadows this one instead of running a
# second icon next to it.
#
# To drop it for your user: systemctl --user mask tailscale-systray.service
[Unit]
Description=Tailscale tray icon
Documentation=https://tailscale.com/kb/1597/linux-systray
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/tailscale systray
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
