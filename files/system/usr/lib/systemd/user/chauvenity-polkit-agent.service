# Polkit authentication agent. GNOME's lives inside gnome-shell, so without
# one of these anything that calls PolicyKit under niri — bootc, systemctl on a
# system unit — fails with no prompt at all.
#
# mate-polkit is used for its agent binary only; its own autostart entry is
# OnlyShowIn=MATE and never fires here.
[Unit]
Description=Polkit authentication agent (niri session)
# Lifetime tied to niri: see niri.service.d/10-chauvenity-session.conf
BindsTo=niri.service
After=niri.service graphical-session.target

[Service]
Type=exec
ExecStart=/usr/libexec/polkit-mate-authentication-agent-1
Restart=on-failure
RestartSec=1
Slice=session.slice
