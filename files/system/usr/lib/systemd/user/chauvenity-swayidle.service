# Idle handling for the niri session: blank, lock, and lock before suspend.
#
# Restart=on-failure matters here more than anywhere else — if swayidle dies
# the session silently stops locking for the rest of the login, with nothing
# on screen to say so.
#
# The `lock` hook is what makes `loginctl lock-session` work; without it that
# command is a no-op under niri.
[Unit]
Description=Idle blanking and locking (niri session)
# BindsTo rather than PartOf: PartOf only propagates an explicit `systemctl
# stop niri.service`. When niri exits on its own the units would otherwise
# outlive it — the polkit agent restart-looping until it fails, the keyring
# oneshot sitting active forever.
BindsTo=niri.service
After=niri.service graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/swayidle -w \
    timeout 600 'swaylock -f' \
    timeout 900 'niri msg action power-off-monitors' \
    resume 'niri msg action power-on-monitors' \
    before-sleep 'swaylock -f' \
    lock 'swaylock -f'
Restart=on-failure
RestartSec=1
Slice=session.slice
