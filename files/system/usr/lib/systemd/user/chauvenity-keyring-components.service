# Secret Service and PKCS#11 for the niri session.
#
# This does NOT start a keyring daemon. gdm's PAM stack already did
# (pam_gnome_keyring.so auto_start in /etc/pam.d/gdm-password), and unlocked it
# with the login password. `gnome-keyring-daemon --start` talks to that running
# daemon over its control socket and asks it to bring these components up —
# exactly what GNOME does from /etc/xdg/autostart/gnome-keyring-secrets.desktop,
# which is OnlyShowIn=GNOME and so never runs here.
[Unit]
Description=Initialize gnome-keyring components (niri session)
# BindsTo rather than PartOf: PartOf only propagates an explicit `systemctl
# stop niri.service`. When niri exits on its own the units would otherwise
# outlive it — the polkit agent restart-looping until it fails, the keyring
# oneshot sitting active forever.
BindsTo=niri.service
After=niri.service graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/gnome-keyring-daemon --start --components=secrets,pkcs11
Slice=session.slice
