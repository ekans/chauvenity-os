# The Quickshell bar for the niri session. Its config ships in
# /etc/xdg/quickshell/chauvenity/ and is overridden from
# ~/.config/quickshell/chauvenity/.
[Unit]
Description=Quickshell bar (niri session)
# Lifetime tied to niri: see niri.service.d/10-chauvenity-session.conf
BindsTo=niri.service
After=niri.service graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/qs -c chauvenity
Restart=on-failure
RestartSec=1
Slice=session.slice
